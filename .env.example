# ── Google Sheets (service account) ──────────────────────────────────────────
# Paste the entire service account key JSON as a single-line string.
# Generate at: Google Cloud Console → IAM & Admin → Service Accounts → Keys → Add Key → JSON
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"YOUR_PROJECT","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"your-sa@your-project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# Google Spreadsheet ID (from the sheet URL between /d/ and /edit)
SPREADSHEET_ID=your-spreadsheet-id-here

# ── Dashboard access (HTTP Basic Auth) ───────────────────────────────────────
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me-to-something-strong

# ── Server ────────────────────────────────────────────────────────────────────
# Railway sets PORT automatically. Leave blank locally to default to 3000.
PORT=

# ── Proposal tracking (/p redirect endpoint) ─────────────────────────────────
# URL that /p redirects to after logging the open. Defaults to the Netlify site if unset.
PROPOSAL_URL=https://your-proposal-site.netlify.app

# ── Outreach agent (outreach-agent.js only — not used by server.js) ───────────
ANTHROPIC_API_KEY=sk-ant-...
PROPOSAL_BASE=https://your-proposal-site.netlify.app
FROM_EMAIL=you@yourdomain.com
FROM_NAME=Your Name (Your Company)
MAILING_ADDRESS=Your Company, Your City, Province

# Railway: paste the full contents of your local token.json as a single-line JSON string.
# The agent reads this instead of token.json when RAILWAY_ENVIRONMENT is set.
# Generate locally: node -e "process.stdout.write(fs.readFileSync('token.json','utf8').replace(/\s/g,''))"
GMAIL_TOKEN_JSON={"access_token":"...","refresh_token":"...","token_type":"Bearer","expiry_date":0}
