# ── Google Sheets (service account) ──────────────────────────────────────────
# Paste the entire service account key JSON as a single-line string.
# Generate at: Google Cloud Console → IAM & Admin → Service Accounts → Keys → Add Key → JSON
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"YOUR_PROJECT","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"your-sa@your-project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# Google Spreadsheet ID (from the sheet URL between /d/ and /edit)
SPREADSHEET_ID=your-spreadsheet-id-here

# ── Dashboard access (HTTP Basic Auth) ───────────────────────────────────────
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me-to-something-strong

# ── Server ────────────────────────────────────────────────────────────────────
# Railway sets PORT automatically. Leave blank locally to default to 3000.
PORT=

# ── Proposal tracking (/p redirect endpoint) ─────────────────────────────────
# URL that /p redirects to after logging the open. Defaults to the Netlify site if unset.
PROPOSAL_URL=https://your-proposal-site.netlify.app

# ── Outreach agent (outreach-agent.js only — not used by server.js) ───────────
ANTHROPIC_API_KEY=sk-ant-...
# Optional stable alias override. The default remains claude-haiku-4-5.
ANTHROPIC_HAIKU_MODEL=claude-haiku-4-5
# Daily token observability. Warn logs and continues. Hard limit 0 = disabled
# until normal usage is measured. Non-critical generation fail-closes; reply
# handling routes to human review instead of dropping the message.
ANTHROPIC_DAILY_TOKEN_WARN=2000000
ANTHROPIC_DAILY_TOKEN_HARD_LIMIT=0
# Roofing survey profile is fail-closed until both rollout decisions are made.
ROOFING_SURVEY_REPLY_FLOW_ENABLED=false
ROOFING_SURVEY_AUTO_REPLY_ENABLED=false
ROOFING_SURVEY_URL=
# IMPORTANT: proposal links in outreach emails must point to your deployed /p tracking route
# (e.g. https://your-domain.railway.app/p?company=...&niche=...) so opens are logged to the
# ProposalOpens sheet tab and open-triggered follow-up detection works correctly.
PROPOSAL_BASE=https://your-proposal-site.netlify.app
FROM_EMAIL=you@yourdomain.com
FROM_NAME=Your Name (Your Company)
SIGNATURE_NAME=Deins Ulmanis
SIGNATURE_COMPANY=ScaleLabAi
SIGNATURE_SITE=scalelabai.ca
SIGNATURE_PHONE=604 836 9902
MAILING_ADDRESS=Your Company, Your City, Province
# Required for staffing (and any commercial) CAN-SPAM/CASL footers. Must be a
# real physical postal address: street address, USPS/CMRA box, or equivalent
# mailing address (PO Box / rural route / general delivery). City-and-province
# only is not valid. Do not invent a value. Staffing sends fail closed without it.
# COMMERCIAL_MAILING_ADDRESS=123 Example Street, City, Province PostalCode
# Per-day ceiling across ALL cron runs combined (Vancouver time).
# Separate from DAILY_CAP which is the per-run ceiling.
# e.g. DAILY_CAP=12 + 6 cron runs/day → could send 72 without this limit.
DAILY_SEND_LIMIT=40
GMAIL_PRIMARY_DAILY_LIMIT=20

# Railway: paste the full contents of your local token.json as a single-line JSON string.
# The agent reads this instead of token.json when RAILWAY_ENVIRONMENT is set.
# Generate locally: node -e "process.stdout.write(fs.readFileSync('token.json','utf8').replace(/\s/g,''))"
GMAIL_TOKEN_JSON={"access_token":"...","refresh_token":"...","token_type":"Bearer","expiry_date":0}

# Optional secondary Gmail inboxes. This registry is dormant and does not alter
# the legacy FROM_EMAIL/GMAIL_TOKEN_JSON sender. Warming inboxes must use a
# zero daily limit. Store each credential in the token variable it names.
GMAIL_INBOX_REGISTRY_JSON=[{"id":"tryscalelabai","email":"deins@tryscalelabai.ca","status":"warming","tokenEnv":"GMAIL_TRYSCALELABAI_TOKEN_JSON","dailyLimit":0}]
GMAIL_TRYSCALELABAI_TOKEN_JSON={"access_token":"...","refresh_token":"...","token_type":"Bearer","expiry_date":0}
GMAIL_READINESS_TOKEN=generate-a-long-random-production-diagnostic-token
# Optional campaign-specific approved pricing copy for warm replies. Omit it to
# fail closed to human review; never place an inferred or placeholder price here.
# Example shape only:
# OFFER_PRICING_JSON={"dental_ai_receptionist":{"approvedWording":"Approved pricing wording supplied by the business"}}
# Separate Google Cloud OAuth client owned by the new mailbox's Workspace.
# Never replace GOOGLE_CLIENT_ID/SECRET; those belong to the live primary inbox.
GMAIL_SECONDARY_GOOGLE_CLIENT_ID=your-secondary-client.apps.googleusercontent.com
GMAIL_SECONDARY_GOOGLE_CLIENT_SECRET=your-secondary-client-secret
GMAIL_SECONDARY_GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback

# ── Name enrichment (enrich-names.js) ────────────────────────────────────────
# Fills blank contactName cells by scraping each lead's About/Team page and
# using Haiku to extract the owner/founder first name.
# Preview (no writes):  DRY_RUN=true  node -r dotenv/config enrich-names.js
# Live  (writes names): DRY_RUN=false node -r dotenv/config enrich-names.js

# ── Smartlead (server only) ───────────────────────────────────────────────────
# Never prefix these with PUBLIC_ or expose them to browser code.
SMARTLEAD_INTEGRATION_ENABLED=false
SMARTLEAD_LIVE_MUTATIONS_ENABLED=false
SMARTLEAD_PILOT_MODE=true
SMARTLEAD_APPROVED_CAMPAIGN_IDS=
SMARTLEAD_TEST_RECIPIENT_ALLOWLIST=
SMARTLEAD_API_KEY=
SMARTLEAD_API_BASE_URL=https://server.smartlead.ai/api/v1
SMARTLEAD_WEBHOOK_SECRET=
SMARTLEAD_REQUEST_TIMEOUT_MS=10000

# ── Send authorization (required at every provider send/enqueue) ─────────────
# SENDING_ENABLED=true is necessary but not sufficient. All of the following
# must be set on the intended production sender only. Confirm the production
# RAILWAY_ENVIRONMENT value before deploy; this repo does not record it.
# SEND_AUTHORIZED_ENV=<exact production RAILWAY_ENVIRONMENT>
# SEND_AUTHORIZED_TOKEN=<secret that exists only on the intended sender>
# SEND_WORKER_ROLE=outreach-sender
SENDING_ENABLED=false

# ── Durable send reservations (Phase 2C, dedicated Postgres) ──────────────────
# Completely separate from Supabase / any future DATABASE_URL. Google Sheets
# remains the lead source of truth. This database stores ONLY outbound send
# leases so overlapping processes cannot double-send.
#
# Pre-activation / local tests: leave SEND_LOCK_ENABLED=false.
# An authorized production sender (the Phase 2B conjunction) cannot send unless
# SEND_LOCK_ENABLED=true. Missing or unreachable lock DB is fail-closed: no
# provider send may occur.
#
# SEND_LOCK_LEASE_SECONDS is only for reclaiming a reserved row whose process
# died BEFORE the provider call began. An expired lease never makes an
# uncertain send retryable.
SEND_LOCK_ENABLED=false
SEND_LOCK_DATABASE_URL=
SEND_LOCK_LEASE_SECONDS=300

