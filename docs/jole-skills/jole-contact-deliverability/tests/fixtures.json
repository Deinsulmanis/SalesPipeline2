{
  "schema": "jole_contact_fixtures_v1",
  "skill_version": "1.0.0",
  "cases": [
    {"id": "E01", "title": "Proofpoint catch-all at a Priority A company",
     "facts": {"identity": "current", "domain_match": "company", "email_status": "VERIFIED", "mx_host": "mxa-00345a01.gslb.pphosted.com", "catch_all": true, "company_priority": "PRIORITY A"},
     "expect": "HOLD"},
    {"id": "E02", "title": "Proofpoint Essentials catch-all",
     "facts": {"identity": "current", "domain_match": "company", "email_status": "VERIFIED", "mx_host": "mx1-us1.ppe-hosted.com", "catch_all": true},
     "expect": "HOLD"},
    {"id": "E03", "title": "Apollo shows an email is available, no verification status",
     "facts": {"identity": "current", "domain_match": "company", "email_status": "none", "mx_host": "example-com.mail.protection.outlook.com", "catch_all": false},
     "expect": "ADDITIONAL VERIFICATION REQUIRED"},
    {"id": "E04", "title": "VERIFIED, non-catch-all Microsoft 365",
     "facts": {"identity": "current", "domain_match": "company", "email_status": "VERIFIED", "mx_host": "example-com.mail.protection.outlook.com", "catch_all": false},
     "expect": "CONTACT ACCEPTED FOR REVIEW"},
    {"id": "E05", "title": "Same address hard-bounced on a ScaleLab send",
     "facts": {"identity": "current", "domain_match": "company", "email_status": "VERIFIED", "mx_host": "example-com.mail.protection.outlook.com", "catch_all": false, "prior_delivery": "hard_bounce", "owned_by_other_client": true},
     "expect": "REJECT"},
    {"id": "E06", "title": "Other catch-all: accepted with a flag",
     "facts": {"identity": "current", "domain_match": "company", "email_status": "VERIFIED", "mx_host": "aspmx.l.google.com", "catch_all": true},
     "expect": "CONTACT ACCEPTED FOR REVIEW", "flagged": true},
    {"id": "E07", "title": "Proofpoint but not catch-all",
     "facts": {"identity": "current", "domain_match": "company", "email_status": "VERIFIED", "mx_host": "mxb-001.gslb.pphosted.com", "catch_all": false},
     "expect": "CONTACT ACCEPTED FOR REVIEW"},
    {"id": "E08", "title": "Proofpoint gateway, catch-all unknown before a reveal",
     "facts": {"identity": "current", "domain_match": "company", "email_status": "VERIFIED", "mx_host": "mxa.gslb.pphosted.com", "catch_all": null},
     "expect": "ADDITIONAL VERIFICATION REQUIRED"},
    {"id": "E09", "title": "UNVERIFIED Apollo email", "facts": {"identity": "current", "domain_match": "company", "email_status": "UNVERIFIED", "mx_host": "mx.example.com", "catch_all": false}, "expect": "ADDITIONAL VERIFICATION REQUIRED"},
    {"id": "E10", "title": "INVALID email", "facts": {"identity": "current", "domain_match": "company", "email_status": "INVALID"}, "expect": "REJECT"},
    {"id": "E11", "title": "Personal domain", "facts": {"identity": "current", "domain_match": "personal", "email_status": "VERIFIED"}, "expect": "REJECT"},
    {"id": "E12", "title": "Unrelated company's domain (alloy.com)", "facts": {"identity": "current", "domain_match": "unrelated", "email_status": "VERIFIED"}, "expect": "REJECT"},
    {"id": "E13", "title": "Parent domain confirmed by the company site", "facts": {"identity": "current", "domain_match": "verified_related", "email_status": "VERIFIED", "mx_host": "mx.parent.example", "catch_all": false}, "expect": "CONTACT ACCEPTED FOR REVIEW"},
    {"id": "E14", "title": "Unresolved domain link", "facts": {"identity": "current", "domain_match": "unresolved", "email_status": "VERIFIED", "mx_host": "mx.other.example", "catch_all": false}, "expect": "ADDITIONAL VERIFICATION REQUIRED"},
    {"id": "E15", "title": "Person has left", "facts": {"identity": "gone", "domain_match": "company", "email_status": "VERIFIED"}, "expect": "REJECT"},
    {"id": "E16", "title": "Suppressed address", "facts": {"identity": "current", "domain_match": "company", "email_status": "VERIFIED", "suppressed": true}, "expect": "REJECT"},
    {"id": "E17", "title": "Domain with a recent delivery deferral", "facts": {"identity": "current", "domain_match": "company", "email_status": "VERIFIED", "mx_host": "mx.example.com", "catch_all": false, "prior_delivery": "deferred"}, "expect": "HOLD"},
    {"id": "E18", "title": "Employment uncertain", "facts": {"identity": "uncertain", "domain_match": "company", "email_status": "VERIFIED", "mx_host": "mx.example.com", "catch_all": false}, "expect": "ADDITIONAL VERIFICATION REQUIRED"}
  ]
}
