{
  "name": "scalelab-pipeline",
  "version": "1.0.0",
  "main": "server.js",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "gmail:connect": "node connect-gmail-inbox.js",
    "test": "node --test",
