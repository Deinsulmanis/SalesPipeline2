    "send-lock:migrate": "node scripts/send-lock-migrate.js",
    "send-lock:verify": "node scripts/send-lock-verify.js",
    "send-lock:health": "node scripts/send-lock-health.js",
    "send-lock:inspect": "node scripts/send-lock-inspect.js",
    "check": "node --check server.js && node --check outreach-agent.js && node --test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.107.0",
    "axios": "^1.18.1",
    "cheerio": "^1.2.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "googleapis": "^144.0.0",
    "node-cron": "^4.5.0",
    "pg": "^8.23.0",
    "puppeteer": "^25.3.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
